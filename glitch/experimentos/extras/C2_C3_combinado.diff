+def _classify_unknown(client: ProjectXClient, account_id: int, signal: dict) -> dict:
+    """PROPUESTA (NO DESPLEGAR): intenta clasificar un cierre UNKNOWN como liquidacion por MLL. Mejor esfuerzo: nunca lanza.
+    Devuelve {"result": "LIQ"|"UNKNOWN", "evidence": ..., "suspected": bool, "pnl": float|None}."""
+    out = {"result": "UNKNOWN", "evidence": None, "suspected": False, "pnl": None}
+    try:
+        active = client.get_accounts(only_active=True)
+    except Exception as e:
+        log.warning(f"_classify_unknown: Account/search (activas) fallo -- {e}")
+        return out
+    all_accounts = None
+    if not active:
+        try:
+            all_accounts = client.get_accounts(only_active=False)
+        except Exception as e:
+            log.warning(f"_classify_unknown: Account/search (todas) fallo -- {e}")
+    floor_abs = None
+    pnl = liq_pnl(signal.get("attempt_pnl_before"), signal.get("attempt_floor"))
+    verdict = classify_unknown_exit(account_id=account_id, active_accounts=active, all_accounts=all_accounts, floor_abs=floor_abs)
+    out.update(verdict)
+    if verdict["result"] == "LIQ":
+        if pnl is None:     # sin el estado previo del intento no se puede registrar un P&L que dispare el QUIEBRE: no se convierte a ciegas
+            out.update(result="UNKNOWN", suspected=True, evidence=(verdict["evidence"] or "") + " | la señal no trae attempt_pnl_before/attempt_floor")
+        else:
+            out["pnl"] = pnl
+    return out
+

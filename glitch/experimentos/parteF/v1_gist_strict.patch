new file mode 100644
index 0000000..e14c66f
--- /dev/null
+++ b/glitch/tests/test_geometry_scheduler_strict.py
@@ -0,0 +1,140 @@
+"""
+V1 (24-oct-2026) -- el scheduler en modo real (DRY_RUN=false) NO debe tragarse los fallos del Gist.
+Recorre run() real hasta Telegram con send/ct_now/date/sleep/front-month parcheados y la API de Gists simulada en memoria (sin red).
+"""
+import datetime as dt
+import importlib
+import json
+import os
+import sys
+
+os.environ.setdefault("MASSIVE_API_KEY", "test-key-not-real")
+os.environ.setdefault("TELEGRAM_BOT_TOKEN", "test-token-not-real")
+os.environ.setdefault("TELEGRAM_CHAT_ID", "test-chat-not-real")
+os.environ.setdefault("GITHUB_GIST_TOKEN", "test-gist-token-not-real")
+os.environ.setdefault("GIST_ID", "test-gist-id-not-real")
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+import pytest
+from zoneinfo import ZoneInfo
+
+import execution.gist_store as gs
+
+CT = ZoneInfo("America/Chicago")
+MON = dt.date(2026, 10, 26)
+HISTORY = [
+    {"date": "2026-10-14", "result": "SL", "pnl": -2000.0, "intento": 1, "direction": "SHORT", "side": -1},
+    {"date": "2026-10-19", "result": "TP", "pnl": 1551.2, "intento": 2, "direction": "SHORT", "side": -1},
+    {"date": "2026-10-20", "result": "TP", "pnl": 1401.2, "intento": 2, "direction": "LONG", "side": 1},
+]
+
+
+class _Resp:
+    def __init__(self, status=200, body=None): self.status_code, self._b = status, body or {}
+    def json(self): return self._b
+    def raise_for_status(self):
+        if self.status_code >= 400: raise RuntimeError(f"HTTP {self.status_code}")
+
+
+class _Gist:
+    """mode: ok | 401 (todo falla) | write401 (lee bien, no escribe) | write_lost (PATCH 200 que no guarda)."""
+    def __init__(self, files, mode="ok"):
+        self.files, self.mode, self.patches = {k: json.dumps(v) for k, v in files.items()}, mode, 0
+    def get(self, *a, **k):
+        return _Resp(401) if self.mode == "401" else _Resp(200, {"files": {k_: {"content": v} for k_, v in self.files.items()}})
+    def patch(self, url, headers=None, json=None, timeout=None, **k):
+        self.patches += 1
+        if self.mode in ("401", "write401"): return _Resp(401)
+        if self.mode != "write_lost":
+            for n, o in json["files"].items(): self.files[n] = o["content"]
+        return _Resp(200)
+    def read(self, n): return __import__("json").loads(self.files[n])
+
+
+@pytest.fixture
+def env(monkeypatch):
+    monkeypatch.setattr(gs, "GITHUB_GIST_TOKEN", "fake"); monkeypatch.setattr(gs, "GIST_ID", "fake")
+    monkeypatch.setenv("GLITCH_PRODUCT", "MES")
+    import scheduler.geometry_scheduler as s
+    s = importlib.reload(s)
+    sent = []
+    now = dt.datetime(2026, 10, 26, 9, 36, tzinfo=CT)
+
+    class FakeDate(dt.date):
+        @classmethod
+        def today(cls): return MON
+
+    monkeypatch.setattr(s, "DRY_RUN", False)
+    monkeypatch.setattr(s, "send", sent.append)
+    monkeypatch.setattr(s, "ct_now", lambda: now)
+    monkeypatch.setattr(s, "date", FakeDate)
+    monkeypatch.setattr(s.time, "sleep", lambda *_: None)
+    monkeypatch.setattr(s, "get_front_month", lambda *_a, **_k: "MESZ6")
+    monkeypatch.setattr(s, "check_expiry_alerts", lambda *_a, **_k: None)
+
+    def go(gist):
+        monkeypatch.setattr(gs.requests, "get", gist.get); monkeypatch.setattr(gs.requests, "patch", gist.patch)
+        s.run()
+        return "\n".join(sent)
+    return s, sent, go
+
+
+def _files(order=None):
+    return {"geometry_mes_log.json": HISTORY, "orden_pendiente_mes.json": order if order is not None else {}}
+
+
+def test_token_revocado_da_un_unico_error_y_no_anuncia_senal(env):
+    s, sent, go = env
+    g = _Gist(_files(), mode="401"); text = go(g)
+    assert len(sent) == 1 and "STATUS: ERROR" in text and "leer el historial" in text
+    assert "INICIO DE DIA" not in text and "[SEÑAL ENVIADA AL PI]" not in text and "Intento #1" not in text
+    assert g.patches == 0
+
+
+def test_lectura_ok_escritura_rechazada_no_anuncia_senal(env):
+    s, sent, go = env
+    g = _Gist(_files(), mode="write401"); text = go(g)
+    assert "STATUS: ERROR" in text and "escribir/verificar la orden" in text and "[SEÑAL ENVIADA AL PI]" not in text
+    assert g.read("orden_pendiente_mes.json") == {}
+
+
+def test_patch_200_que_no_guarda_se_detecta_por_lectura_posterior(env):
+    s, sent, go = env
+    g = _Gist(_files(), mode="write_lost"); text = go(g)
+    assert "NO quedo escrita" in text and "[SEÑAL ENVIADA AL PI]" not in text
+
+
+def test_camino_feliz_escribe_verifica_y_anuncia_en_ese_orden(env):
+    s, sent, go = env
+    g = _Gist(_files()); text = go(g)
+    assert sent[0].startswith("S10GLITCH - COMBINE - MES | INICIO DE DIA") and "Resultado de ayer: 2026-10-20: LONG → TP  PnL=$+1,401.20" in sent[0]
+    orden = g.read("orden_pendiente_mes.json")
+    assert orden == {"date": "2026-10-26", "side": 1, "direction": "LONG", "ticker": "MES=F", "product_code": "MES", "nc": 40,
+                     "sl_ticks": 100, "tp_ticks": 32, "product": "MES", "intento": 2, "dry_run": False}
+    assert "[SEÑAL ENVIADA AL PI]" in sent[-1] and "Intento #2" in sent[-1]
+
+
+def test_orden_vieja_sin_consumir_bloquea_y_con_401_ya_no_pasa_en_silencio(env):
+    s, sent, go = env
+    viejo = {"date": "2026-10-19", "side": 1, "nc": 3}
+    g = _Gist(_files(viejo)); text = go(g)
+    assert "STATUS: BLOCKED" in text and g.read("orden_pendiente_mes.json") == viejo
+    sent.clear()
+    text = go(_Gist(_files(viejo), mode="401"))
+    assert "STATUS: ERROR" in text and "BLOCKED" not in text and "[SEÑAL ENVIADA AL PI]" not in text
+
+
+def test_gist_store_state_strict(monkeypatch):
+    monkeypatch.setattr(gs, "GITHUB_GIST_TOKEN", "fake"); monkeypatch.setattr(gs, "GIST_ID", "fake")
+    g = _Gist({"a.json": {"x": 1}, "lista.json": [1]})
+    monkeypatch.setattr(gs.requests, "get", g.get); monkeypatch.setattr(gs.requests, "patch", g.patch)
+    assert gs.load_state_strict("a.json") == {"x": 1} and gs.load_state_strict("no_existe.json") == {}
+    with pytest.raises(gs.GistError):
+        gs.load_state_strict("lista.json")            # tipo equivocado
+    gs.save_state_strict("b.json", {"y": 2}); assert g.read("b.json") == {"y": 2}
+    bad = _Gist({}, mode="401")
+    monkeypatch.setattr(gs.requests, "get", bad.get); monkeypatch.setattr(gs.requests, "patch", bad.patch)
+    with pytest.raises(gs.GistError):
+        gs.load_state_strict("a.json")
+    with pytest.raises(gs.GistError):
+        gs.save_state_strict("a.json", {})

+class TestGistFailuresAreNotSwallowed:
+    """V1 (24-oct-2026): con el token del Gist revocado (401) el modo real NO debe anunciar una señal inexistente."""
+    def _env(self, s, monkeypatch, **kw):
+        e = Env(s, monkeypatch, **kw)
+        from execution.gist_store import GistError
+        return e, GistError
+
+    def test_history_read_failure_gives_error_and_nothing_else(self, real_sched, monkeypatch):
+        e, GistError = self._env(real_sched, monkeypatch)
+        def boom(): raise GistError("lectura de geometry_mgc_log.json fallo: 401")
+        monkeypatch.setattr(real_sched, "load_log_strict", boom)
+        real_sched.run()
+        assert len(e.sent) == 1 and "STATUS: ERROR" in e.sent[0] and "leer el historial" in e.sent[0]
+        assert e.store[real_sched.ORDER_FILE] == {}
+
+    def test_order_write_failure_does_not_announce(self, real_sched, monkeypatch):
+        e, GistError = self._env(real_sched, monkeypatch)
+        def boom(f, d): raise GistError("escritura fallo: 401")
+        monkeypatch.setattr(real_sched, "_gist_save_state_strict", boom)
+        real_sched.run()
+        assert any("STATUS: ERROR" in m for m in e.sent) and not any("SEÑAL ENVIADA AL PI" in m for m in e.sent)
+
+    def test_lost_write_is_detected_by_read_back(self, real_sched, monkeypatch):
+        e, GistError = self._env(real_sched, monkeypatch)
+        monkeypatch.setattr(real_sched, "_gist_save_state_strict", lambda f, d: None)       # PATCH 200 que no guarda
+        real_sched.run()
+        assert any("NO quedo escrita" in m for m in e.sent) and not any("SEÑAL ENVIADA AL PI" in m for m in e.sent)
+
+    def test_unreadable_pending_order_is_error_not_silent_pass(self, real_sched, monkeypatch):

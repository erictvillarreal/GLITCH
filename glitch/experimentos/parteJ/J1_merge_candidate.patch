+def _ticker_month_year(product: str, ticker: str, ref_year: int):
+    m = re.match(rf"^{re.escape(product)}([FGHJKMNQUVXZ])(\d{{1,2}})$", ticker)
+    if not m:
+        return None
+    month = _MONTH_CODES[m.group(1)]
+    yy = int(m.group(2))
+    year = (ref_year // 100) * 100 + yy if yy >= 10 else (ref_year // 10) * 10 + yy
+    if year < ref_year - 5:
+        year += 10
